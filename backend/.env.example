# Security Secret Key (Use a strong random secret in production, >=32 bytes)
SECRET_KEY=mess-planning-production-secret-key-replace-this-min32bytes

# Algorithm for JWT
ALGORITHM=HS256

# JWT Access Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./mess_planning.db

# Model and metrics paths (optional overrides)
# MODEL_PATH=../mess_prediction_model.joblib
# METRICS_PATH=../mess_model_metrics.json

# Mess default capacity
DEFAULT_MESS_CAPACITY=556
